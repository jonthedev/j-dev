# Static assets - serve file (first match wins; _redirects is processed before netlify.toml)
/favicon.ico    /favicon.ico    200
/favicon-16x16.png    /favicon-16x16.png    200
/favicon-32x32.png    /favicon-32x32.png    200
/apple-touch-icon.png    /apple-touch-icon.png    200
/site.webmanifest    /site.webmanifest    200
/robots.txt    /robots.txt    200
/llms.txt    /llms.txt    200
/404.html    /404.html    200
/_nuxt/*    /_nuxt/:splat    200
# No agent catalog. A 200 HTML rewrite makes Lighthouse parse index.html as JSON.
/.well-known/ai-catalog.json    /404.html    404
/.well-known/ard.json    /404.html    404
# SPA: serve index.html for all other routes (client-side routing)
/*    /index.html    200
